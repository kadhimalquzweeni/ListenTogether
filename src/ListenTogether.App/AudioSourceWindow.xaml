<Window x:Class="ListenTogether.App.AudioSourceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ListenTogether.App"
        Title="Choose audio sources — ListenTogether"
        Width="960" Height="760" MinWidth="820" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <Style x:Key="ModeRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ModeBorder" Background="#20232B" BorderBrush="#343A48"
                                BorderThickness="1" CornerRadius="11" Padding="18">
                            <StackPanel>
                                <TextBlock Text="{TemplateBinding Content}" />
                                <TextBlock Text="{TemplateBinding Tag}" FontSize="11" FontWeight="Normal"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,7,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeBorder" Property="Background" Value="#2A3044" />
                                <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModeBorder" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ModeBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SourceCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="CheckBorder" Width="19" Height="19" CornerRadius="5"
                                    BorderBrush="#566074" BorderThickness="1" Background="#171A21">
                                <Path x:Name="CheckMark" Data="M 3,9 L 7,13 L 15,4" Stroke="#FFFFFF"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CheckBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VolumeSlider" TargetType="Slider">
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="20" VerticalAlignment="Center">
                            <Track x:Name="PART_Track" IsDirectionReversed="False" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False" IsTabStop="False" Height="4">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{StaticResource AccentBrush}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="#F4F5FA" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False" IsTabStop="False" Height="4">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="#414858" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="Choose your audio" FontSize="27" FontWeight="SemiBold" />
                <TextBlock Text="Select exactly what you want everyone in your session to hear."
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,7,0,0" />
            </StackPanel>
            <Button Content="✕" Style="{StaticResource SmallActionButton}" Width="38" Height="36"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnCloseClick" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <RadioButton Grid.Column="0" GroupName="SourceMode" Style="{StaticResource ModeRadio}"
                         Content="All system audio" Tag="Everything played through your default output device."
                         IsChecked="{Binding IsSystemAudioMode}" IsEnabled="{Binding IsCapturing, Converter={StaticResource InverseBooleanConverter}}" />
            <RadioButton Grid.Column="2" GroupName="SourceMode" Style="{StaticResource ModeRadio}"
                         Content="Selected applications" Tag="Choose multiple apps and control each one separately."
                         IsChecked="{Binding IsSystemAudioMode, Converter={StaticResource InverseBooleanConverter}}" IsEnabled="{Binding IsCapturing, Converter={StaticResource InverseBooleanConverter}}" />
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="#303541"
                BorderThickness="1" CornerRadius="14" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{Binding AvailableApplicationCount, StringFormat={}{0} applications available}"
                                   FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Select the applications to include in the shared mix."
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,5,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}"
                            Style="{StaticResource SmallActionButton}" HorizontalAlignment="Right"
                            IsEnabled="{Binding IsCapturing, Converter={StaticResource InverseBooleanConverter}}" />
                </Grid>

                <Grid Grid.Row="1">
                    <StackPanel Visibility="{Binding IsSystemAudioMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border Background="#191C24" CornerRadius="10" Padding="18">
                            <StackPanel>
                                <TextBlock Text="System output" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Text="All audio from your PC's default playback device will be captured."
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Volume" VerticalAlignment="Center" FontSize="12" />
                            <Slider Grid.Column="1" Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="100"
                                    Value="{Binding SystemAudioSource.Volume, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2" Text="{Binding SystemAudioSource.Volume, StringFormat={}{0:0}%}"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" FontSize="12" />
                            <CheckBox Grid.Column="3" Content="Mute" Style="{StaticResource SourceCheckBox}"
                                      IsChecked="{Binding SystemAudioSource.IsMuted}" Margin="14,0,0,0" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsApplicationMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ApplicationSources}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#191C24" CornerRadius="9" Padding="14" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="190" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="48" />
                                                    <ColumnDefinition Width="58" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" Style="{StaticResource SourceCheckBox}"
                                                          IsChecked="{Binding IsSelected}"
                                                          IsEnabled="{Binding DataContext.IsCapturing, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanConverter}}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding ProcessId, StringFormat=PID {0}}"
                                                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <Slider Grid.Column="2" Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="100"
                                                        IsEnabled="{Binding IsSelected}"
                                                        Value="{Binding Volume, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Grid.Column="3" Text="{Binding Volume, StringFormat={}{0:0}%}"
                                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                <CheckBox Grid.Column="4" Content="Mute" Style="{StaticResource SourceCheckBox}"
                                                          IsEnabled="{Binding IsSelected}" IsChecked="{Binding IsMuted}"
                                                          HorizontalAlignment="Right" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" MaxWidth="480" />
                <TextBlock Text="{Binding OutputLevel, StringFormat=Output level  •  {0:0}%}"
                           FontSize="10" Foreground="#7F8AA2" Margin="0,5,0,0" />
                <TextBlock Text="{Binding SessionCode, StringFormat=Invite code: {0}}" FontSize="12"
                           Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,5,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Stop capture" Command="{Binding StopCommand}"
                    Style="{StaticResource SecondaryButton}" IsEnabled="{Binding IsCapturing}" />
            <Button Grid.Column="5" Content="Start sharing" Command="{Binding StartCommand}"
                    Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanStart}" />
        </Grid>
    </Grid>
</Window>
