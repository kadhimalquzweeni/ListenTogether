<Window x:Class="ListenTogether.App.ListeningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Listening together"
        Width="620" Height="500" MinWidth="540" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="You're in the session" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="Audio is streamed live from the host's selected applications."
                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,7,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="#303541"
                BorderThickness="1" CornerRadius="16" Padding="24">
            <StackPanel VerticalAlignment="Center">
                <Border Width="64" Height="64" CornerRadius="18" Background="#30364B"
                        HorizontalAlignment="Center" Margin="0,0,0,18">
                    <TextBlock Text="♫" FontSize="34" Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding HostDisplayName}" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="HOSTING THIS SESSION" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"
                           Margin="0,6,0,22" />
                <Border Background="#191C24" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="13" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock Text="{Binding ParticipantCount, StringFormat={}{0} people in this session}"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,9,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Button Content="Leave session" Command="{Binding LeaveCommand}"
                    Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Width="150" />
        </Grid>
    </Grid>
</Window>
