<Window x:Class="ListenTogether.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ListenTogether"
        Width="1040"
        Height="700"
        MinWidth="820"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,34">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="42" Height="42" CornerRadius="12" Background="#30364B" Margin="0,0,12,0">
                    <TextBlock Text="♫" FontSize="25" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ListenTogether" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Share what you're listening to" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="SERVER ADDRESS" FontSize="9" FontWeight="SemiBold"
                               Foreground="#858DA0" Margin="2,0,0,4" />
                    <TextBox Style="{StaticResource DarkTextBox}" Width="220" FontSize="11"
                             Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Your ListenTogether relay URL (for local testing, http://localhost:5000)" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="YOUR NAME" FontSize="9" FontWeight="SemiBold"
                               Foreground="#858DA0" Margin="2,0,0,4" />
                    <TextBox Style="{StaticResource DarkTextBox}" Width="112" FontSize="11"
                             Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Name shown to other listeners" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="820" HorizontalAlignment="Center">
            <TextBlock Text="Good audio is better together." FontSize="34" FontWeight="SemiBold"
                       HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBlock Text="Create a private listening session or join someone with an invite code."
                       FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,12,0,38" HorizontalAlignment="Center" TextAlignment="Center" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}" CornerRadius="16"
                        BorderBrush="#303541" BorderThickness="1" Padding="26">
                    <StackPanel>
                        <Border Width="48" Height="48" CornerRadius="13" Background="#30364B"
                                HorizontalAlignment="Left" Margin="0,0,0,20">
                            <TextBlock Text="♫" FontSize="25" Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Create a session" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Start sharing audio from your PC. Choose individual apps or all system audio."
                                   TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="13" LineHeight="20" Margin="0,10,0,24" />
                        <Button Content="Create session" Command="{Binding CreateSessionCommand}"
                                Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource PanelBackgroundBrush}" CornerRadius="16"
                        BorderBrush="#303541" BorderThickness="1" Padding="26">
                    <StackPanel>
                        <Border Width="48" Height="48" CornerRadius="13" Background="#30364B"
                                HorizontalAlignment="Left" Margin="0,0,0,20">
                            <TextBlock Text="⇥" FontSize="25" Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Join a session" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Enter the invite code shared by the person hosting the audio."
                                   TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="13" LineHeight="20" Margin="0,10,0,17" />
                        <Button Content="Paste invite details" Click="OnPasteInviteDetailsClick"
                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Margin="0,0,0,10" />
                        <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding SessionCode, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="12" ToolTip="Enter session code" />
                        <Button Content="Join session" Command="{Binding JoinSessionCommand}"
                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="#303541"
                    BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="HOST YOUR SERVER" FontSize="10" FontWeight="SemiBold"
                               Foreground="#858DA0" Margin="0,0,0,8" />
                    <TextBlock Text="Start or stop the signalling server, STUN and secure HTTPS endpoint on this PC."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ACME EMAIL" FontSize="9" FontWeight="SemiBold"
                                       Foreground="#858DA0" Margin="2,0,0,4" />
                            <TextBox Style="{StaticResource DarkTextBox}" FontSize="11"
                                     Text="{Binding AcmeEmail, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Email used by Let's Encrypt for Caddy certificate management" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="Start Server" Command="{Binding StartServerCommand}"
                                    Style="{StaticResource PrimaryButton}" MinWidth="125" />
                            <Button Content="Stop Server" Command="{Binding StopServerCommand}"
                                    Style="{StaticResource SecondaryButton}" MinWidth="110" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                    <CheckBox Content="Hide PowerShell window (run in background)"
                              IsChecked="{Binding HideServerConsole}"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              FontSize="11" Margin="2,10,0,0"
                              ToolTip="Starts PowerShell without showing its console. If startup fails, turn this off to see the error output." />
                    <TextBlock Text="Requires the published server, Caddy 2.10+, and the router setup to be completed once."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"
                               TextWrapping="Wrap" Margin="2,8,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12,0,0">
                <Button Content="Check if I can host" Command="{Binding CheckHostingCommand}"
                        Style="{StaticResource SecondaryButton}" MinWidth="190" />
                <TextBlock Text="Checks server health and UDP STUN from this PC."
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                           VerticalAlignment="Center" Margin="14,0,0,0" />
            </StackPanel>

            <Border Background="#20232B" CornerRadius="10" Padding="14" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                               MaxWidth="560" />
                    <Button Content="Copy details" Click="OnCopyHostingDetailsClick"
                            Margin="14,0,0,0" Padding="12,6">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanCopyHostingResult}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>

        <DockPanel Grid.Row="2" Margin="0,30,0,0"/>
    </Grid>
</Window>
